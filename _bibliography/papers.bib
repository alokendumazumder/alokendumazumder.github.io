@article{mazumder2026lisa,
  title = {{LISA}: Latent Inference on the Sphere for A-posteriori sampling},
  author = {Alokendu Mazumder and Chirag Garg and Tirthajit Baruah and Punit Rathore},
  year = {2026},
  month = {sep},
  abbr = {TMLR},
  selected = {true},
  bibtex_show = {true},
  research_areas = {representation, generative},
  journal = {Transactions on Machine Learning Research},
  url = {https://openreview.net/forum?id=f0agX08y69},
  html = {https://openreview.net/forum?id=f0agX08y69},
  pdf = {https://openreview.net/pdf?id=f0agX08y69},
  preview = {lisa.png},
  abstract = {LISA conditions the latent geometry of deterministic autoencoders for ex-post generation by projecting codes onto a hypersphere and encouraging directional coverage with a repulsive kernel regularizer. Coupled with projected multivariate Gaussian or Gaussian-mixture samplers, it improves generation across image benchmarks without stochastic encoders, adversarial training, or learned priors. Grammar-LISA extends the approach to structured arithmetic expressions.},
}

