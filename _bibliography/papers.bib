@inproceedings{chaudhary2021dibr,
  title = {Perceptual Quality Assessment of DIBR Synthesized Views Using Saliency Based Deep Features},
  author = {Shubham Chaudhary and Alokendu Mazumder and Deebha Mumtaz and Vinit Jakhetiya and Badri N. Subudhi},
  year = {2021},
  abbr = {ICIP},
  selected = {false},
