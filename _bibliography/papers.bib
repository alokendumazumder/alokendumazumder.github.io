@article{mazumder2026adam,
  title = {On Convergence of ADAM with Data Dependent Stepsize},
  author = {Alokendu Mazumder and Rishabh Sabharwal and Bhartendu Kumar* and Manan Tayal* and Chirag Garg* and Arnab Roy* and Punit Rathore},
  year = {2026},
  abbr = {IEEE TAI},
  selected = {true},
  bibtex_show = {true},
  research_areas = {optimization},
  journal = {IEEE Transactions on Artificial Intelligence},
  url = {https://ieeexplore.ieee.org/document/11361385},
  pdf = {https://ieeexplore.ieee.org/document/11361385},
  code = {https://github.com/alokendumazumder/IEEE_TAI_ADAM_Convergence},
  abstract = {We propose a data and dynamics driven constant stepsize for Adam that removes the need for costly tuning and avoids the pitfalls of decaying schedulers. Our estimate matches the best stepsizes found by exhaustive search, performs on par with popular schedulers, and scales to ImageNet and LLM fine-tuning. We further provide theory showing that Adam with our stepsize converges to critical points for smooth non-convex objectives.},
}

@article{mazumder2025fractional,
  title = {Fractional Gradient Descent with Matrix Stepsizes for Non-Convex Optimization},
  author = {Alokendu Mazumder and Keshav Vyas and Punit Rathore},
  year = {2025},
  abbr = {IEEE TNNLS},
  selected = {true},
  bibtex_show = {true},
  research_areas = {optimization},
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  url = {https://ieeexplore.ieee.org/document/11298544},
  pdf = {https://ieeexplore.ieee.org/document/11298544},
  code = {https://github.com/alokendumazumder/IEEE_TNNLS_Compressed_fractional_GD},
  abstract = {We establish convergence guarantees for fractional gradient descent on matrix-smooth non-convex functions and show how matrix smoothness accelerates convergence. We introduce Compressed Fractional Gradient Descent (CFGD) with matrix-valued stepsizes, proving faster convergence than scalar stepsizes in both single-node and distributed settings. This work studies fractional gradient descent in federated/distributed optimisation.},
}

