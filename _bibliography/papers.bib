  booktitle = {IEEE International Conference on Image Processing},
  url = {https://ieeexplore.ieee.org/document/9506607},
  pdf = {https://ieeexplore.ieee.org/document/9506607},
  abstract = {We propose an efficient no-training perceptual quality metric for DIBR synthesized views that exploits saliency-guided deep features extracted from a pretrained VGG-16 network. By focusing on perceptually important regions and fusing feature maps using cosine similarity, the method captures geometric distortions on standard benchmarks.},
